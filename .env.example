# 複製這個檔成 .env，並填入你的 Google Maps API 金鑰
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY

# (選用) 3D 傾斜導航用的向量地圖 Map ID，留空則用 2D
VITE_GOOGLE_MAPS_MAP_ID=

# 地圖同步 MQTT（導航時把路線/即時位置發給 public/map-sync.html 後台）
# 瀏覽器只能走 WebSocket；App 是 HTTPS 時要用 wss://。1883 是純 TCP，瀏覽器連不到。
# 自架 broker(118.163.180.29) 需另開 websockets listener，例如 ws://118.163.180.29:9001
VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt
# 房間名稱：map-sync.html 後台要填一模一樣才收得到
VITE_MQTT_ROOM=ebike-demo
